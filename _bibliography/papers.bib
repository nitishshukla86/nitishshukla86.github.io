@article{shukla2026sieve,
  abbr={Under review},
  title={SIEVE: Preserving Cross-Image Evidence via Depth-Aware Token Compression},
  author={Shukla, Nitish and Jandial, Surgan and Bui, Nhat-Tan and Ross, Arun},
  journal={arXiv preprint arXiv:2611.00351},
  year={2026},
  arxiv={2611.00351},
  website={https://nitishshukla86.github.io/SIEVE/},
  note={Under review},
  preview={sieve_preview.png},
  abstract={SIEVE is a training-free method for multi-image vision-language models that uses up to 16x fewer visual tokens. It pools each image before the decoder, then selects and merges tokens in stages over decoder depth, with an equal quota per image so that no single image consumes the budget. At one eighth of the tokens, it retains 93--103% of the uncompressed accuracy across four open vision-language backbones and, on LLaVA-OneVision-7B, reduces prefill compute by 6.6x and the KV cache by 6.4x. It requires no fine-tuning, labeled data, or architectural changes.},
  selected={true},
  bibtex_show={true},
  keywords={visual token pruning, multi-image VLMs, efficient inference, training-free}
}

