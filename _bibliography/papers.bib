  preview={sdemorph_arch.png},
  abstract={SDeMorph (Stably Diffused De-morpher) is a reference-free demorphing method that recovers the identities of bona fides. It utilizes Denoising Diffusion Probabilistic Models (DDPM) by destroying the input morphed signal and reconstructing it using a branched-UNet, producing feature-rich, high-quality outputs. Experiments on AMSL, FRLL-FaceMorph, FRLL-MorDIFF, and SMDD support its effectiveness.},
  doi={10.1109/IJCB57857.2023.10448779},
  bibtex_show={true},
  keywords={face demorphing, diffusion models, biometrics}
}
