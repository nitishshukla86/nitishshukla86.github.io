---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.carousel %}
          <div class="portrait-carousel" aria-roledescription="carousel" aria-label="Portraits">
            <div class="portrait-frame">
              {% for slide in page.profile.carousel %}
                <figure class="portrait-slide{% if forloop.first %} active{% endif %}" aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}">
                  <img
                    src="{{ slide.image | prepend: 'assets/img/portraits/' | relative_url }}"
                    alt="{% if slide.technique %}Portrait inspired by {{ slide.technique }}{% else %}Nitish Shukla{% endif %}"
                    class="img-fluid z-depth-1"
                    {% unless forloop.first %}loading="lazy"{% endunless %}
                  >
                  <figcaption>
                    {% if slide.branch %}
                      <span class="branch"><i class="fa-solid fa-code-branch"></i> {{ slide.branch }}</span>
                    {% endif %}
                    {% if slide.technique %}
                      <span class="inspired">Inspired by //</span>
                      <span class="technique technique-{{ slide.style }}">
                        {%- if slide.style == 'compression' -%}
                          {%- assign words = slide.technique | split: ' ' -%}
                          {%- for word in words -%}<span class="w w{{ forloop.index }}">{{ word }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
                        {%- else -%}
                          {{ slide.technique }}
                        {%- endif -%}
                      </span>
                    {% endif %}
                  </figcaption>
                </figure>
              {% endfor %}
              <div class="portrait-nav-zone">
                <button type="button" class="portrait-nav prev" aria-label="Previous portrait"><i class="fa-solid fa-chevron-left"></i></button>
                <button type="button" class="portrait-nav next" aria-label="Next portrait"><i class="fa-solid fa-chevron-right"></i></button>
              </div>
            </div>
          </div>
          <script>
            (function () {
              const root = document.currentScript.previousElementSibling;
              const slides = root.querySelectorAll(".portrait-slide");
              let i = 0;
              const show = (n) => {
                slides[i].classList.remove("active");
                slides[i].setAttribute("aria-hidden", "true");
                i = (n + slides.length) % slides.length;
                slides[i].classList.add("active");
                slides[i].setAttribute("aria-hidden", "false");
              };
              // advance every 2 s; pause while the pointer or keyboard focus is on the carousel,
              // and not at all for visitors who ask for reduced motion
              const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
              let timer = null;
              const stop = () => { clearInterval(timer); timer = null; };
              const start = () => { stop(); if (!still) timer = setInterval(() => show(i + 1), 2000); };
              const step = (d) => { show(i + d); start(); };
              root.querySelector(".prev").addEventListener("click", () => step(-1));
              root.querySelector(".next").addEventListener("click", () => step(1));
              root.addEventListener("keydown", (e) => {
                if (e.key === "ArrowLeft") step(-1);
                if (e.key === "ArrowRight") step(1);
              });
              root.addEventListener("mouseenter", stop);
              root.addEventListener("mouseleave", start);
              root.addEventListener("focusin", stop);
              root.addEventListener("focusout", start);
              document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
              start();
            })();
          </script>
        {% elsif page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
